{
  "env": {
    "ANTHROPIC_API_KEY": "sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
    "ANTHROPIC_BASE_URL": "https://api.ppio.com/anthropic",
    "ANTHROPIC_MODEL": "pa/claude-sonnet-4-6",
    "ANTHROPIC_SMALL_FAST_MODEL": "pa/claude-sonnet-4-6",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(perl:*)"
    ]
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": false,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "git",
        "url": "https://github.com/thedotmack/claude-mem.git"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "/home/tanshuil/.claude/statusline-command.sh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/post-git-commit.sh"
          }
        ]
      }
    ]
  }
}
